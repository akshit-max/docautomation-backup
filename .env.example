# ==========================================
# makewithus Document Automation System
# Environment Variables Configuration
# ==========================================

# ── NEXT.JS API LAYER (.env) ────────────────────────────────────────────────
# These variables should be placed in `web/.env`

# OpenRouter API key for LLM generation and translation
OPENROUTER_API_KEY="sk-or-v1-..."

# The LLM model to use (default fallback: openai/gpt-oss-20b:free)
LLM_MODEL="anthropic/claude-sonnet-4"

# Internal API Secret — Must match the frontend's VITE_INTERNAL_API_SECRET
INTERNAL_API_SECRET="your-secure-random-secret"

# Python OCR Microservice URL
PYTHON_OCR_URL="http://localhost:8000/extract"

# Firebase Admin Credentials
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client configuration (public)
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"


# ── FRONTEND (.env) ────────────────────────────────────────────────────────
# These variables should be placed in `frontend/.env`

# The base URL of the Next.js API layer
VITE_API_URL="http://localhost:3000"

# Must match INTERNAL_API_SECRET from Next.js
VITE_INTERNAL_API_SECRET="your-secure-random-secret"


# ── PYTHON OCR SERVICE (.env) ──────────────────────────────────────────────
# These variables should be placed in `backend/.env`
# The OCR microservice currently does not require any external API keys.
# It runs purely locally on port 8000.

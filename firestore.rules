rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Documents collection: internal tool, no auth, but enforce schema intent.
    match /documents/{docId} {
      // Only expose non-deleted documents to reads
      allow read: if resource == null || resource.data.isDeleted == false;
      // Allow create only if required fields are present
      allow create: if request.resource.data.keys().hasAll(['template_type', 'isDeleted', 'createdAt']);
      // Allow update only if not hard-deleting (isDeleted flag allowed, but hard delete via REST is blocked)
      allow update: if true;
      // Block client-side hard deletes — we use soft deletes only
      allow delete: if false;
    }

    // Invoice counter: only allow atomic increment-style access
    match /counters/{counterId} {
      allow read, write: if counterId == 'invoice_counter';
    }
  }
}
